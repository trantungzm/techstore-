{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=techStore1;Trusted_Connection=True;MultipleActiveResultSets=True;Encrypt=False;TrustServerCertificate=True"
  },
  "AppSettings": {
    "IsProduction": false
  },
  "Jwt": {
    "Issuer": "BaseCore",
    "Audience": "BaseCore.WebClient"
  },
  "Database": {
    "AutoMigrateOnStartup": false
  }
}
